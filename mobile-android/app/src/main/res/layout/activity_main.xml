<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Thông tin người dùng & Vai trò (Role Badge) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvWelcomeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xin chào, Nguyễn Văn A"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUserCodeAndRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mã: SV2026001 | Vai trò: SINH VIÊN"
            android:textColor="#E3F2FD"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvFaculty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đơn vị: Khoa Công nghệ Thông tin"
            android:textColor="#BBDEFB"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Khu vực chức năng dành cho Sinh viên / Giảng viên -->
    <LinearLayout
        android:id="@+id/layoutBorrowerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="CHỨC NĂNG MƯỢN TRẢ THIẾT BỊ"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBrowseEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tra cứu Thiết bị &amp; Đăng ký Mượn" />

        <Button
            android:id="@+id/btnMyBorrowHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Phiếu mượn của tôi" />
    </LinearLayout>

    <!-- Khu vực chức năng dành riêng cho Kỹ thuật viên / Quản trị viên (Ẩn với SV/GV) -->
    <LinearLayout
        android:id="@+id/layoutStaffActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="QUẢN LÝ KHO &amp; PHÊ DUYỆT (KỸ THUẬT VIÊN / ADMIN)"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnApproveRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2E7D32"
            android:text="Duyệt Phiếu Mượn &amp; Quét QR Giao/Trả" />

        <Button
            android:id="@+id/btnManageUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#6A1B9A"
            android:text="Quản lý Người dùng &amp; Phân quyền (Admin)" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#C62828"
        android:text="ĐĂNG XUẤT"
        android:textColor="#FFFFFF" />

</LinearLayout>
