<?xml version="1.0" encoding="utf-8"?>
<!-- Soft pastel ambient glow background used on auth screens (Stitch .ambient-glow). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/background" />
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|end"
        android:right="-120dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FBF8FF"
                android:gradientRadius="180dp"
                android:startColor="@color/glow_lavender"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="top|start"
        android:left="-160dp"
        android:top="140dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FBF8FF"
                android:gradientRadius="190dp"
                android:startColor="@color/glow_peach"
                android:type="radial" />
        </shape>
    </item>
</layer-list>