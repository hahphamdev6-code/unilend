<?xml version="1.0" encoding="utf-8"?>
<!-- Register screen — generated from Stitch "UniLend Mobile" > "UniLend Mobile Register". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_ambient"
    android:orientation="vertical"
    tools:context=".ui.auth.RegisterActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_auth_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- ===== Hero visual ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#99FFFFFF"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgHero"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_register_hero"
                        app:layout_constraintDimensionRatio="16:9"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:alpha="0.66"
                        android:background="@drawable/bg_hero_scrim"
                        app:layout_constraintBottom_toBottomOf="@id/imgHero"
                        app:layout_constraintEnd_toEndOf="@id/imgHero"
                        app:layout_constraintStart_toStartOf="@id/imgHero"
                        app:layout_constraintTop_toTopOf="@id/imgHero" />

                    <!-- Trust badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/white_90"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        app:layout_constraintBottom_toBottomOf="@id/imgHero"
                        app:layout_constraintStart_toStartOf="parent">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_verified_user_fill"
                            app:tint="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="@string/register_hero_insured"
                            android:textAppearance="@style/TextAppearance.UniLend.LabelSm"
                            android:textColor="@color/ink" />
                    </LinearLayout>

                    <!-- Rating pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/ink_80"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_fill"
                            app:tint="@color/rating_star" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/register_hero_rating"
                            android:textAppearance="@style/TextAppearance.UniLend.LabelSm"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Hero typography ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/secondary_fixed_half"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/chipDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/register_hero_chip"
                    android:textAppearance="@style/TextAppearance.UniLend.LabelSm"
                    android:textColor="@color/secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/register_hero_title"
                android:textAppearance="@style/TextAppearance.UniLend.HeadlineMd" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/register_hero_subtitle"
                android:textAppearance="@style/TextAppearance.UniLend.BodyMd" />

            <!-- ===== Registration form card ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_form_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/register_title"
                        android:textAppearance="@style/TextAppearance.UniLend.HeadlineSm" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_step"
                        android:textAppearance="@style/TextAppearance.UniLend.LabelSm"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>

                <!-- 1. Full name -->
                <TextView
                    style="@style/Widget.UniLend.FieldLabel"
                    android:labelFor="@id/etFullName"
                    android:text="@string/label_full_name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFullName"
                    style="@style/Widget.UniLend.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/surface_container_low"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        style="@style/Widget.UniLend.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:hint="@string/hint_full_name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Email -->
                <TextView
                    style="@style/Widget.UniLend.FieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etEmail"
                    android:text="@string/label_email" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.UniLend.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/surface_container_low"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        style="@style/Widget.UniLend.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:hint="@string/hint_email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. Password -->
                <TextView
                    style="@style/Widget.UniLend.FieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etPassword"
                    android:text="@string/label_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.UniLend.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/surface_container_low"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/on_surface_variant"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        style="@style/Widget.UniLend.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_password_register"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password strength indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/password_strength_label"
                        android:textAppearance="@style/TextAppearance.UniLend.LabelSm"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/tvStrength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/strength_none"
                        android:textAppearance="@style/TextAppearance.UniLend.LabelSm"
                        android:textColor="@color/secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/strengthBars"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/surface_variant" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/surface_variant" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/surface_variant" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/surface_variant" />
                </LinearLayout>

                <!-- 4. Confirm password -->
                <TextView
                    style="@style/Widget.UniLend.FieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etConfirmPassword"
                    android:text="@string/label_confirm_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.UniLend.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/surface_container_low"
                    app:endIconDrawable="@drawable/ic_check_circle_fill"
                    app:endIconMode="custom"
                    app:endIconTint="@color/success"
                    app:startIconDrawable="@drawable/ic_lock_reset"
                    app:startIconTint="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        style="@style/Widget.UniLend.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_confirm_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 5. Agreement -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/register_terms"
                    android:textAppearance="@style/TextAppearance.UniLend.BodySm"
                    app:buttonTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    style="@style/Widget.UniLend.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/action_create_account"
                    app:cornerRadius="26dp" />

                <!-- Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/surface_variant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/or_sign_up_with"
                        android:textAppearance="@style/TextAppearance.UniLend.LabelSm"
                        android:textColor="@color/outline" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/surface_variant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.UniLend.Button.Google"
                    android:layout_width="match_parent"
                    android:text="@string/continue_with_google"
                    app:cornerRadius="25dp"
                    app:strokeColor="#80C4C7C7" />
            </LinearLayout>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_have_account"
                    android:textAppearance="@style/TextAppearance.UniLend.BodyMd" />

                <TextView
                    android:id="@+id/tvSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:padding="4dp"
                    android:text="@string/register_sign_in"
                    android:textAppearance="@style/TextAppearance.UniLend.BodyMd"
                    android:textColor="@color/on_surface" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
