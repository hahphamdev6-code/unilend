<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Bottom Navigation Island (Shared across MainActivity & ProfileActivity) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="0dp"
    android:layout_height="64dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_translucent"
    app:cardCornerRadius="32dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Khám phá -->
        <TextView
            android:id="@+id/navExplore"
            style="@style/Widget.UniLend.HomeNavItem"
            android:background="@drawable/bg_nav_active"
            android:drawableTop="@drawable/ic_explore"
            android:drawableTint="@color/on_primary"
            android:text="Khám phá"
            android:textColor="@color/on_primary" />

        <!-- Đã lưu -->
        <TextView
            android:id="@+id/navSaved"
            style="@style/Widget.UniLend.HomeNavItem"
            android:drawableTop="@drawable/ic_bookmark"
            android:drawableTint="@color/outline"
            android:text="Đã lưu" />

        <!-- Mượn trả -->
        <TextView
            android:id="@+id/navBookings"
            style="@style/Widget.UniLend.HomeNavItem"
            android:drawableTop="@drawable/ic_calendar"
            android:drawableTint="@color/outline"
            android:text="Mượn trả" />

        <!-- Cá nhân -->
        <TextView
            android:id="@+id/navProfile"
            style="@style/Widget.UniLend.HomeNavItem"
            android:drawableTop="@drawable/ic_person"
            android:drawableTint="@color/outline"
            android:text="Cá nhân" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
